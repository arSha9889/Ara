# Copy this file to deploy/production.env on the server and fill real values.
# Never commit deploy/production.env: it contains secrets.

# Public domain bought at reg.ru. First point its A record to the server IP.
NEXUS_PUBLIC_DOMAIN=nexus.example.ru

# Email for Let's Encrypt/Caddy certificate notifications.
NEXUS_ACME_EMAIL=admin@example.ru

# Internal PostgreSQL credentials used by docker compose.
NEXUS_POSTGRES_DB=nexus
NEXUS_POSTGRES_USER=nexus
NEXUS_POSTGRES_PASSWORD=change-me-to-a-long-random-password

# API runtime.
NEXUS_ALLOWED_ORIGINS=["https://nexus.example.ru"]
NEXUS_STORAGE_PUBLIC_URL_PREFIX=/storage/uploads
NEXUS_STORAGE_PUBLIC_BASE_URL=https://nexus.example.ru

# Generate long random secrets, for example:
# openssl rand -hex 32
NEXUS_REGISTRATION_PROOF_SECRET=change-me-registration-proof-secret
NEXUS_ACCESS_TOKEN_SECRET=change-me-access-token-secret

# Telegram bot for real registration.
NEXUS_TELEGRAM_BOT_TOKEN=
NEXUS_TELEGRAM_BOT_NAME=
NEXUS_TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# Web Push. HTTPS is required in production.
# Generate the pair from apps/api after installing requirements:
# .venv/bin/python -c "import base64; from cryptography.hazmat.primitives.serialization import Encoding, NoEncryption, PrivateFormat, PublicFormat; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('NEXUS_VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(v.private_key.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())).rstrip(b'=').decode()); print('NEXUS_VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).rstrip(b'=').decode())"
NEXUS_VAPID_PRIVATE_KEY=
NEXUS_VAPID_PUBLIC_KEY=
NEXUS_VAPID_CLAIMS_EMAIL=mailto:admin@example.ru

# WebRTC calls: self-hosted TURN server via coturn.
# NEXUS_TURN_EXTERNAL_IP must be the public IPv4 of the server that exposes UDP/TCP 3478.
# Generate a long random password, for example: openssl rand -base64 32
NEXUS_TURN_REALM=nexus.example.ru
NEXUS_TURN_EXTERNAL_IP=203.0.113.10
NEXUS_TURN_USERNAME=nexus-turn
NEXUS_TURN_PASSWORD=change-me-to-a-long-random-turn-password
NEXUS_TURN_MIN_PORT=49160
NEXUS_TURN_MAX_PORT=49200

# Browser ICE configuration as JSON. Keep it on one line.
VITE_RTC_ICE_SERVERS=[{"urls":["stun:nexus.example.ru:3478","turn:nexus.example.ru:3478?transport=udp","turn:nexus.example.ru:3478?transport=tcp"],"username":"nexus-turn","credential":"change-me-to-a-long-random-turn-password"}]

# Optional tuning.
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=30
NEXUS_PIN_TRUSTED_DAYS=365
NEXUS_EARLY_ACCESS_BYPASS_LIMIT=100
NEXUS_UPLOAD_MAX_SIZE_BYTES=104857600

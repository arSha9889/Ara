# Copy this file to deploy/production.env on the server and fill real values.
# Never commit deploy/production.env: it contains secrets.

# Public domain bought at reg.ru. First point its A record to the server IP.
NEXUS_PUBLIC_DOMAIN=arachat.example

# Email for Let's Encrypt/Caddy certificate notifications.
NEXUS_ACME_EMAIL=admin@example.ru

# Internal PostgreSQL credentials used by docker compose.
NEXUS_POSTGRES_DB=nexus
NEXUS_POSTGRES_USER=nexus
NEXUS_POSTGRES_PASSWORD=change-me-to-a-long-random-password

# API runtime.
NEXUS_ALLOWED_ORIGINS=["https://arachat.example"]
NEXUS_PUBLIC_BASE_URL=https://arachat.example

# Production media storage: any S3-compatible provider works. Cloudflare R2 example:
# NEXUS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# NEXUS_S3_REGION=auto
# NEXUS_S3_BUCKET=arachat-media
# NEXUS_S3_ACCESS_KEY_ID=<R2 API token access key id>
# NEXUS_S3_SECRET_ACCESS_KEY=<R2 API token secret access key>
# Keep the bucket private: block public access and do not connect a public media domain.
# The API reads objects using these server-only credentials after authorizing each request.
NEXUS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
NEXUS_S3_REGION=auto
NEXUS_S3_BUCKET=arachat-media
NEXUS_S3_ACCESS_KEY_ID=
NEXUS_S3_SECRET_ACCESS_KEY=
NEXUS_S3_PREFIX=uploads

# Generate long random secrets, for example:
# openssl rand -hex 32
NEXUS_REGISTRATION_PROOF_SECRET=change-me-registration-proof-secret
NEXUS_ACCESS_TOKEN_SECRET=change-me-access-token-secret

# SMTP is required for registration, password recovery and e-mail changes.
# Configure SPF, DKIM and DMARC for the sender domain before public launch.
NEXUS_SMTP_HOST=smtp.example.ru
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USERNAME=mailer@example.ru
NEXUS_SMTP_PASSWORD=change-me-smtp-password
NEXUS_SMTP_FROM_EMAIL=no-reply@arachat.example
NEXUS_SMTP_FROM_NAME=AraChat
NEXUS_SMTP_USE_STARTTLS=true
NEXUS_SMTP_USE_SSL=false
NEXUS_SMTP_TIMEOUT_SECONDS=15

# Optional backup sign-in methods. Register these exact callback URLs at the
# providers: https://arachat.example/api/auth/oauth/yandex/callback and
# https://arachat.example/api/auth/oauth/vk/callback.
NEXUS_YANDEX_OAUTH_CLIENT_ID=
NEXUS_YANDEX_OAUTH_CLIENT_SECRET=
NEXUS_VK_OAUTH_CLIENT_ID=
# Service access token from VK ID, required for a confidential web application.
NEXUS_VK_OAUTH_SERVICE_TOKEN=

# Telegram is optional legacy functionality and is not used for registration,
# password changes or password recovery.
NEXUS_TELEGRAM_BOT_TOKEN=
NEXUS_TELEGRAM_BOT_NAME=
NEXUS_TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# The verified e-mail allowed to administer Ara Updates and the admin panel.
# Set it only in deploy/production.env; never commit a real address.
NEXUS_ADMIN_EMAIL=
# Legacy optional fallback for an existing phone-based administrator.
NEXUS_ADMIN_PHONE=

# Web Push. HTTPS is required in production.
# Generate the pair from apps/api after installing requirements:
# .venv/bin/python -c "import base64; from cryptography.hazmat.primitives.serialization import Encoding, NoEncryption, PrivateFormat, PublicFormat; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('NEXUS_VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(v.private_key.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())).rstrip(b'=').decode()); print('NEXUS_VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).rstrip(b'=').decode())"
NEXUS_VAPID_PRIVATE_KEY=
NEXUS_VAPID_PUBLIC_KEY=
NEXUS_VAPID_CLAIMS_EMAIL=mailto:admin@example.ru

# Mobile Push through RuStore Universal Push API. Keep delivery false until the
# signed-device prototype has passed. `NEXUS_RUSTORE_PUSH_SERVICE_TOKEN` is a
# server-only secret. For FCM, mount the service-account JSON outside Git and
# expose only its container path here.
NEXUS_MOBILE_PUSH_ENABLED=false
NEXUS_MOBILE_PUSH_TIMEOUT_SECONDS=10
NEXUS_RUSTORE_PUSH_PROJECT_ID=
NEXUS_RUSTORE_PUSH_SERVICE_TOKEN=
NEXUS_FCM_PUSH_PROJECT_ID=
# Host path to the JSON key, mounted read-only into the API container. Keep the
# file owner-readable only; it must not live in this repository. Set both FCM
# paths only when testing or enabling the FCM provider; an empty host path uses
# the Compose /dev/null fallback and does not require a key file.
NEXUS_FCM_SERVICE_ACCOUNT_HOST_FILE=
NEXUS_FCM_SERVICE_ACCOUNT_FILE=

# Audio calls use the self-hosted coturn server. `NEXUS_TURN_PUBLIC_HOST` must
# resolve publicly to this VPS; `NEXUS_TURN_EXTERNAL_IP` is the VPS public IPv4.
# The API creates per-user credentials that expire automatically. Generate the
# shared secret with: openssl rand -hex 32
NEXUS_TURN_REALM=arachat.example
NEXUS_TURN_PUBLIC_HOST=arachat.example
NEXUS_TURN_EXTERNAL_IP=203.0.113.10
NEXUS_TURN_SHARED_SECRET=change-me-to-a-long-random-turn-secret
NEXUS_TURN_PORT=3478
NEXUS_TURN_CREDENTIAL_TTL_SECONDS=3600
NEXUS_TURN_MIN_PORT=49160
NEXUS_TURN_MAX_PORT=49200
# Maximum active allocations across the TURN server. Keep this proportional to
# VPS bandwidth and monitor it before raising the value.
NEXUS_TURN_TOTAL_QUOTA=120

# Optional tuning.
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=180
NEXUS_PIN_TRUSTED_DAYS=365
# 0 means open registration. Set a positive number only for an invitation-only beta.
NEXUS_EARLY_ACCESS_BYPASS_LIMIT=0
NEXUS_UPLOAD_MAX_SIZE_BYTES=31457280
# Redis is used only for short-lived rate-limit keys. This limit prevents a
# runaway cache from exhausting VPS memory; expired keys can be evicted safely.
NEXUS_REDIS_MAXMEMORY=256mb

# Copy this file to deploy/staging.env on the VPS. It contains secrets and is ignored by Git.
# Staging must use a separate HTTPS hostname, database, Redis volume and secrets from production.

# The staging hostname, for example staging.example.ru. Do not include https:// or a trailing slash.
NEXUS_PUBLIC_DOMAIN=staging.example.ru

# The browser origin and public API base URL. Android does not need CORS, but these values
# keep the future staging web client and OAuth callbacks isolated from production.
NEXUS_ALLOWED_ORIGINS=["https://staging.example.ru"]
NEXUS_PUBLIC_BASE_URL=https://staging.example.ru

# Docker network shared only by the production Caddy container and staging API.
# On this project's production Compose deployment it is nexus-production_caddy_proxy.
# Verify that Caddy is connected to it with:
# docker inspect nexus-production-caddy-1 --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}'
NEXUS_CADDY_PROXY_NETWORK=nexus-production_caddy_proxy

# Local uploads are intentionally used for staging only. They are available only through
# the API media routes after authorization; do not expose the upload volume in a proxy.

# Separate PostgreSQL credentials. Use URL-safe hexadecimal secrets so the password is safe
# inside the PostgreSQL connection URL generated by Docker Compose.
NEXUS_POSTGRES_DB=arachat_staging
NEXUS_POSTGRES_USER=arachat_staging
NEXUS_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Generate distinct values with: openssl rand -hex 32
NEXUS_REGISTRATION_PROOF_SECRET=replace-with-a-different-random-value
NEXUS_ACCESS_TOKEN_SECRET=replace-with-a-different-random-value

# SMTP is mandatory for the e-mail confirmation and password recovery flows.
# Prefer a staging-only sender and mailbox. Never use an individual user's mailbox password.
NEXUS_SMTP_HOST=smtp.example.ru
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USERNAME=staging-mailer@example.ru
NEXUS_SMTP_PASSWORD=replace-with-smtp-password-or-app-password
NEXUS_SMTP_FROM_EMAIL=staging-no-reply@example.ru
NEXUS_SMTP_FROM_NAME=AraChat Staging
NEXUS_SMTP_USE_STARTTLS=true
NEXUS_SMTP_USE_SSL=false
NEXUS_SMTP_TIMEOUT_SECONDS=15

# Mobile Push through RuStore Universal Push API. Keep it disabled until a
# signed Android test build has passed. Do not commit the RuStore service token
# or the Firebase service-account JSON.
NEXUS_MOBILE_PUSH_ENABLED=false
NEXUS_MOBILE_PUSH_TIMEOUT_SECONDS=10
NEXUS_RUSTORE_PUSH_PROJECT_ID=
NEXUS_RUSTORE_PUSH_SERVICE_TOKEN=
NEXUS_FCM_PUSH_PROJECT_ID=
# Set both only when testing the FCM provider. The host key must be outside Git,
# owner-readable only; an empty host path uses the Compose /dev/null fallback.
NEXUS_FCM_SERVICE_ACCOUNT_HOST_FILE=
NEXUS_FCM_SERVICE_ACCOUNT_FILE=

# Keep Android update notices disabled until staging has an approved HTTPS page
# and a release version code. Direct APK and RuStore metadata can be configured
# independently; verify the installer package before enabling the RuStore path.
NEXUS_ANDROID_LATEST_VERSION_CODE=
NEXUS_ANDROID_DIRECT_DOWNLOAD_URL=
NEXUS_ANDROID_RUSTORE_APP_URL=
NEXUS_ANDROID_RUSTORE_INSTALLER_PACKAGE=

# Audio-call staging uses its own TURN credentials and non-overlapping host
# ports, so it can share a VPS with production. The host must resolve publicly
# to this same VPS; use a distinct staging hostname and a different secret.
# Generate the secret with: openssl rand -hex 32
NEXUS_TURN_REALM=staging.example.ru
NEXUS_TURN_PUBLIC_HOST=staging.example.ru
NEXUS_TURN_EXTERNAL_IP=203.0.113.10
NEXUS_TURN_SHARED_SECRET=replace-with-a-different-random-turn-secret
NEXUS_TURN_PORT=3479
NEXUS_TURN_CREDENTIAL_TTL_SECONDS=900
NEXUS_TURN_MIN_PORT=49201
NEXUS_TURN_MAX_PORT=49240
NEXUS_TURN_TOTAL_QUOTA=40

# Staging defaults: no artificial registration limit, reduced token lifetime and a small Redis cap.
NEXUS_EARLY_ACCESS_BYPASS_LIMIT=0
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=30
NEXUS_PIN_TRUSTED_DAYS=30
NEXUS_UPLOAD_MAX_SIZE_BYTES=10485760
NEXUS_REDIS_MAXMEMORY=128mb

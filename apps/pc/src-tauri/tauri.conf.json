{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AraChat",
  "version": "0.1.0",
  "identifier": "ru.arachat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AraChat",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking"
  }
}

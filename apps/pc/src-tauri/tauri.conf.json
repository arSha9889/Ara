{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AraChat",
  "version": "0.9.5",
  "identifier": "ru.arachat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AraChat",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost https://aramsg.ru wss://aramsg.ru http://localhost:8000 ws://localhost:8000",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost https://aramsg.ru blob: data:",
        "media-src": "'self' asset: http://asset.localhost https://aramsg.ru blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/nsis/assets/installer-sidebar.bmp",
        "headerImage": "windows/nsis/assets/installer-header.bmp",
        "uninstallerHeaderImage": "windows/nsis/assets/uninstaller-header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEQzY1MUQ2MjQzNzA3RUMKUldUc0J6Y2sxbEhHSFRhbEZHVTd3Qnh6NUdTNGk4Q2FnZ05CQiswMzVEck96cUVTYm9QRTlKU04K",
      "endpoints": [
        "https://aramsg.ru/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

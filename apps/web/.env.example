# Public URL of the API. Do not add a trailing slash.
# Leave empty in production when the web server proxies /api to the API on the same domain.
VITE_API_BASE_URL=https://api-production.up.railway.app
# WebSocket endpoint of the same API. Do not add a trailing slash.
# Leave empty in production when the web server proxies /ws to the API on the same domain.
VITE_WS_BASE_URL=wss://api-production.up.railway.app
# Telegram bot username, without the @ sign.
VITE_TELEGRAM_BOT_NAME=

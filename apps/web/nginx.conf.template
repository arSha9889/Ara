map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# The Caddy container is the only public entrypoint and supplies X-Real-IP.
# These limits protect SMTP delivery and authentication from simple online abuse.
limit_req_zone $http_x_real_ip zone=auth_delivery:10m rate=3r/m;
limit_req_zone $http_x_real_ip zone=auth_requests:10m rate=10r/m;

server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Allow the API limit of a 30 MiB file plus small multipart/form-data overhead.
  client_max_body_size 31m;
  proxy_ssl_server_name on;

  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location /api/ {
    proxy_pass ${NEXUS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location ~ ^/api/auth/(?:email-verification/start|phone-verification/start|password/(?:change/start|reset/start)|email/change/start|oauth/(?:vk|yandex)/(?:start|link/start))$ {
    limit_req zone=auth_delivery burst=3 nodelay;
    limit_req_status 429;
    proxy_pass ${NEXUS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location ~ ^/api/auth/(?:login|refresh|phone-verification/confirm|email-verification/confirm|register/complete|password/(?:change/confirm|reset/confirm)|email/change/confirm|oauth/(?:vk|yandex)/callback|oauth/(?:login|link)/complete)$ {
    limit_req zone=auth_requests burst=10 nodelay;
    limit_req_status 429;
    proxy_pass ${NEXUS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location /health {
    proxy_pass ${NEXUS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location /ws {
    proxy_pass ${NEXUS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_buffering off;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location /storage/uploads/ {
    proxy_pass ${NEXUS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

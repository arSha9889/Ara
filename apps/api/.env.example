NEXUS_ENVIRONMENT=dev
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
# Optional for a one-instance closed beta. Required before running multiple API instances.
NEXUS_REDIS_URL=redis://localhost:6379/0
NEXUS_ALLOWED_ORIGINS=["http://localhost:5173"]
NEXUS_TELEGRAM_BOT_TOKEN=
# Optional explicit username without @ for links from the registration form to the bot.
NEXUS_TELEGRAM_BOT_NAME=
# Optional secret passed to Telegram setWebhook and checked from X-Telegram-Bot-Api-Secret-Token.
NEXUS_TELEGRAM_WEBHOOK_SECRET=
# Administrator access is bound to a verified e-mail, not a profile contact number.
# Leave the legacy phone fallback empty so that number can be saved in the profile.
NEXUS_ADMIN_EMAIL=
NEXUS_ADMIN_PHONE=
NEXUS_REGISTRATION_PROOF_SECRET=dev-registration-proof-secret-change-me
NEXUS_ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=180
NEXUS_PIN_TRUSTED_DAYS=365
NEXUS_PIN_LOCK_MINUTES=30
NEXUS_MAX_AUTH_ATTEMPTS=5
NEXUS_UPLOAD_DIR=storage/uploads
NEXUS_UPLOAD_MAX_SIZE_BYTES=31457280
# Legacy prefix used only inside local storage keys; the API does not expose it as an HTTP path.
NEXUS_STORAGE_PUBLIC_URL_PREFIX=/storage/uploads
# Keep local storage for development. Set `s3` in production with an S3-compatible provider
# such as Cloudflare R2, AWS S3 or MinIO. The API authorizes every message and support
# attachment before streaming it, so the bucket must not allow public reads.
NEXUS_STORAGE_BACKEND=local
NEXUS_S3_ENDPOINT_URL=
NEXUS_S3_REGION=auto
NEXUS_S3_BUCKET=
NEXUS_S3_ACCESS_KEY_ID=
NEXUS_S3_SECRET_ACCESS_KEY=
NEXUS_S3_PREFIX=uploads
# Optional backup sign-in methods. Set the public web URL and register these
# exact callbacks with the providers before adding the provider credentials.
NEXUS_PUBLIC_BASE_URL=
NEXUS_YANDEX_OAUTH_CLIENT_ID=
NEXUS_YANDEX_OAUTH_CLIENT_SECRET=
NEXUS_VK_OAUTH_CLIENT_ID=
# VK ID confidential web applications require a service access token here,
# not the protected key used by its browser SDK.
NEXUS_VK_OAUTH_SERVICE_TOKEN=
# NEXUS_VAPID_PRIVATE_KEY accepts a PEM file path or URL-safe base64 DER key.
# Generate an environment-safe pair with:
# .venv/bin/python -c "import base64; from cryptography.hazmat.primitives.serialization import Encoding, NoEncryption, PrivateFormat, PublicFormat; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('NEXUS_VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(v.private_key.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())).rstrip(b'=').decode()); print('NEXUS_VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).rstrip(b'=').decode())"
NEXUS_VAPID_PRIVATE_KEY=
NEXUS_VAPID_PUBLIC_KEY=
NEXUS_VAPID_CLAIMS_EMAIL=mailto:security@example.com
# Mobile Push delivers through every configured provider. Set this to false for
# an emergency delivery stop. The RuStore service token and Firebase
# service-account JSON are server secrets: never put either one in the Android
# project, an APK, or a committed .env file.
NEXUS_MOBILE_PUSH_ENABLED=true
NEXUS_MOBILE_PUSH_TIMEOUT_SECONDS=10
NEXUS_RUSTORE_PUSH_PROJECT_ID=
NEXUS_RUSTORE_PUSH_SERVICE_TOKEN=
NEXUS_FCM_PUSH_PROJECT_ID=
# Absolute path available only to the API process, for example
# /run/secrets/arachat-fcm-service-account.json.
NEXUS_FCM_SERVICE_ACCOUNT_FILE=
# Android update metadata is optional. Leave all of these empty until the
# official HTTPS pages and the verified RuStore installer package are known.
# Configure at least one approved channel; direct APK and RuStore can be rolled
# out independently.
NEXUS_ANDROID_LATEST_VERSION_CODE=
NEXUS_ANDROID_DIRECT_DOWNLOAD_URL=
NEXUS_ANDROID_RUSTORE_APP_URL=
NEXUS_ANDROID_RUSTORE_INSTALLER_PACKAGE=
# Audio calls: the production coturn server verifies credentials made from this
# secret. Never expose it to browser clients.
NEXUS_TURN_PUBLIC_HOST=
NEXUS_TURN_SHARED_SECRET=
NEXUS_TURN_PORT=3478
NEXUS_TURN_CREDENTIAL_TTL_SECONDS=3600

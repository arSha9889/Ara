NEXUS_ENVIRONMENT=dev
# Railway provides DATABASE_URL as postgresql://...; the API converts it to asyncpg automatically.
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
# Optional for a one-instance closed beta. Required before running multiple API instances.
NEXUS_REDIS_URL=redis://localhost:6379/0
NEXUS_ALLOWED_ORIGINS=["http://localhost:5173"]
NEXUS_TELEGRAM_BOT_TOKEN=
# Optional explicit username without @ for links from the registration form to the bot.
NEXUS_TELEGRAM_BOT_NAME=
# Optional secret passed to Telegram setWebhook and checked from X-Telegram-Bot-Api-Secret-Token.
NEXUS_TELEGRAM_WEBHOOK_SECRET=
NEXUS_REGISTRATION_PROOF_SECRET=dev-registration-proof-secret-change-me
NEXUS_ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=180
NEXUS_PIN_TRUSTED_DAYS=365
NEXUS_PIN_LOCK_MINUTES=30
NEXUS_MAX_AUTH_ATTEMPTS=5
NEXUS_UPLOAD_DIR=storage/uploads
NEXUS_UPLOAD_MAX_SIZE_BYTES=31457280
NEXUS_STORAGE_PUBLIC_URL_PREFIX=/storage/uploads
NEXUS_STORAGE_PUBLIC_BASE_URL=http://localhost:8000
# Keep local storage for development. Set `s3` in production with an S3-compatible provider
# such as Cloudflare R2, AWS S3 or MinIO. The API uploads objects; browser clients only read
# them through the public media domain, so these credentials never reach the frontend.
NEXUS_STORAGE_BACKEND=local
NEXUS_S3_ENDPOINT_URL=
NEXUS_S3_REGION=auto
NEXUS_S3_BUCKET=
NEXUS_S3_ACCESS_KEY_ID=
NEXUS_S3_SECRET_ACCESS_KEY=
NEXUS_S3_PREFIX=uploads
NEXUS_S3_PUBLIC_BASE_URL=
# NEXUS_VAPID_PRIVATE_KEY accepts a PEM file path or URL-safe base64 DER key.
# Generate an environment-safe pair with:
# .venv/bin/python -c "import base64; from cryptography.hazmat.primitives.serialization import Encoding, NoEncryption, PrivateFormat, PublicFormat; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('NEXUS_VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(v.private_key.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())).rstrip(b'=').decode()); print('NEXUS_VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).rstrip(b'=').decode())"
NEXUS_VAPID_PRIVATE_KEY=
NEXUS_VAPID_PUBLIC_KEY=
NEXUS_VAPID_CLAIMS_EMAIL=mailto:security@example.com
